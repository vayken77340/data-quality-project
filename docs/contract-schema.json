{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataContract",
  "type": "object",
  "required": [
    "version",
    "epic",
    "table",
    "fields"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "epic": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "sheet_name": {
          "type": "string"
        }
      }
    },
    "table": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Field": {
      "type": "object",
      "required": [
        "silver_name",
        "extract_name",
        "bronze_name",
        "type"
      ],
      "properties": {
        "silver_name": {
          "type": "string",
          "minLength": 1
        },
        "extract_name": {
          "type": "string",
          "minLength": 1
        },
        "bronze_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "int32",
            "int64",
            "float32",
            "float64",
            "decimal",
            "boolean",
            "date",
            "timestamp",
            "timestamp_tz",
            "binary",
            "unknown"
          ]
        },
        "physical_type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "primary_key": {
          "type": "boolean"
        },
        "foreign_key": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string"
            },
            "column": {
              "type": "string"
            }
          },
          "required": [
            "table",
            "column"
          ],
          "additionalProperties": false
        },
        "data_values": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "unique": {
          "type": "boolean",
          "const": true
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "min_value": {
          "type": "object",
          "properties": {
            "value": {},
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "value",
            "strict"
          ],
          "additionalProperties": false
        },
        "max_value": {
          "type": "object",
          "properties": {
            "value": {},
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "value",
            "strict"
          ],
          "additionalProperties": false
        },
        "format": {
          "type": "string",
          "enum": [
            "email",
            "iban",
            "phone",
            "uuid"
          ]
        },
        "default": {}
      },
      "additionalProperties": false
    }
  }
}
