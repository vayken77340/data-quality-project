<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Data quality report - epic {{ p.run.epic }}</title>
<style>
  :root {
    --c-header:  #305496;
    --c-red:     #FCE4E4;
    --c-yellow:  #FFF2CC;
    --c-green:   #E2EFDA;
    --c-text:    #1f1f1f;
    --c-muted:   #666;
    --c-border:  #d8d8d8;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--c-text); margin: 0; background: #fafafa; line-height: 1.45;
  }
  .container { max-width: 1100px; margin: 0 auto; padding: 24px; }
  .banner {
    padding: 24px; border-radius: 6px; margin-bottom: 20px;
    display: flex; align-items: center; justify-content: space-between;
    background: var(--c-header); color: #fff;
  }
  .banner.pass { background: var(--c-header); }
  .banner.fail { background: #B85450; }
  .banner h1 { font-size: 20px; margin: 0; font-weight: 600; }
  .banner .score { font-size: 36px; font-weight: 700; }
  .banner .meta { font-size: 13px; opacity: 0.85; }

  .grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 20px 0;
  }
  .card {
    background: #fff; border: 1px solid var(--c-border); border-radius: 6px;
    padding: 14px; text-align: center;
  }
  .card .label { font-size: 12px; color: var(--c-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .card .value { font-size: 26px; font-weight: 600; margin-top: 4px; }
  .card .sub { font-size: 12px; color: var(--c-muted); margin-top: 2px; }

  h2 { font-size: 16px; margin-top: 28px; border-bottom: 1px solid var(--c-border); padding-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; background: #fff; margin: 10px 0; font-size: 13px; }
  th { background: var(--c-header); color: #fff; text-align: left; padding: 8px; font-weight: 600; }
  td { padding: 8px; border-bottom: 1px solid var(--c-border); }
  tr.pass td  { background: var(--c-green); }
  tr.warn td  { background: var(--c-yellow); }
  tr.fail td  { background: var(--c-red); }

  .issue { background: #fff; border: 1px solid var(--c-border); border-radius: 6px;
           padding: 12px 14px; margin: 8px 0; }
  .issue .count { display: inline-block; background: var(--c-header); color: #fff;
                  border-radius: 12px; padding: 2px 9px; font-size: 12px; font-weight: 600; }
  .issue .kind { font-weight: 600; margin-left: 6px; }
  .issue .hint { color: var(--c-muted); margin-top: 4px; font-size: 13px; }

  details { background: #fff; border: 1px solid var(--c-border); border-radius: 6px;
            margin: 10px 0; padding: 4px 0; }
  details summary { padding: 10px 14px; cursor: pointer; font-weight: 600; user-select: none; }
  details[open] summary { border-bottom: 1px solid var(--c-border); }
  details .body { padding: 10px 14px; }

  /* Compact issue-as-<details> wrapper. List-marker hidden so the summary line
     mirrors the old .issue card visually but is clickable to expand. */
  details.issue { padding: 0; }
  details.issue > summary { padding: 12px 14px; font-weight: normal; list-style: none; }
  details.issue > summary::-webkit-details-marker { display: none; }
  details.issue > summary::before { content: "\25B8 "; color: var(--c-muted); margin-right: 4px; font-size: 11px; }
  details.issue[open] > summary::before { content: "\25BE "; }
  details.issue > .body { padding: 4px 14px 12px; border-top: 1px solid var(--c-border); }

  table.top-values, table.violations {
    width: auto; min-width: 60%; font-size: 12px; margin: 6px 0 0;
  }
  table.top-values th, table.violations th { font-size: 11px; padding: 4px 8px; }
  table.top-values td, table.violations td { padding: 4px 8px; font-family: ui-monospace, "SF Mono", Consolas, monospace; }
  table.top-values tr.remainder td { font-style: italic; color: var(--c-muted); font-family: inherit; }

  /* Rejected-row card */
  .rejected-row { background: #fff; border: 1px solid var(--c-border); border-radius: 6px;
                  padding: 10px 14px; margin: 8px 0; }
  .rejected-row .head { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .rejected-row .pk { margin-top: 4px; font-size: 12px; color: var(--c-muted); }
  .rejected-row .pk code { color: var(--c-text); }

  .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px;
          font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; }
  .pill.completeness { background: #E5F1FB; color: #1F5D8C; }
  .pill.validity     { background: #FFF2CC; color: #8A6600; }
  .pill.uniqueness   { background: #FBE5E5; color: #8C1F1F; }
  .pill.consistency  { background: #E2EFDA; color: #2D7A30; }

  footer { margin-top: 40px; padding: 16px; background: #fff; border: 1px solid var(--c-border);
           border-radius: 6px; font-size: 12px; color: var(--c-muted); }
  footer dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  footer dt { font-weight: 600; color: var(--c-text); }
</style>
</head>
<body>
<div class="container">

{# 1. Header banner #}
<div class="banner {{ 'pass' if p.summary.pass else 'fail' }}">
  <div>
    <h1>{{ p.run.epic }} - data quality report</h1>
    <div class="meta">{{ p.run.generated_at }}
      {% if p.run.target %} - target: <strong>{{ p.run.target.name }}</strong>{% endif %}
    </div>
  </div>
  <div style="text-align: right;">
    <div class="score">{{ "%.1f"|format(p.summary.score) }} / 100</div>
    <div class="meta">{{ p.run.status }} - {{ p.run.status_reason }}</div>
  </div>
</div>

{# 2. Executive summary card grid #}
<div class="grid">
  <div class="card">
    <div class="label">Errors</div>
    <div class="value">{{ p.summary.by_severity.error }}</div>
  </div>
  <div class="card">
    <div class="label">Warnings</div>
    <div class="value">{{ p.summary.by_severity.warning }}</div>
  </div>
  <div class="card">
    <div class="label">Tables</div>
    <div class="value">{{ p.tables|length }}</div>
  </div>
  <div class="card">
    <div class="label">Duration</div>
    <div class="value">{{ p.run.duration_ms }}<span style="font-size:14px;">ms</span></div>
  </div>
</div>

{# 3. Quality dimensions panel #}
<h2>Quality dimensions</h2>
<div class="grid">
  {% for dim, ds in p.summary.by_dimension.items() %}
  <div class="card">
    <div class="label"><span class="pill {{ dim }}">{{ dim }}</span></div>
    <div class="value">{{ "%.1f"|format(ds.score) }}</div>
    <div class="sub">{{ ds.violations }} violation{{ '' if ds.violations == 1 else 's' }}</div>
  </div>
  {% endfor %}
</div>

{# 4. Per-table table #}
<h2>Tables</h2>
<table>
  <thead>
    <tr><th>Table</th><th>Score</th><th>Rows</th><th>Clean</th><th>Errors</th><th>Warnings</th></tr>
  </thead>
  <tbody>
  {% for t in p.tables %}
    {% set n_err = t.violations|selectattr('severity','equalto','error')|list|length %}
    {% set n_warn = t.violations|selectattr('severity','equalto','warning')|list|length %}
    {% set cls = 'fail' if n_err else ('warn' if n_warn else 'pass') %}
    <tr class="{{ cls }}">
      <td><strong>{{ t.table }}</strong></td>
      <td>{{ "%.1f"|format(t.score) }}</td>
      <td>{{ t.input.total_rows }}</td>
      <td>{{ t.input.clean_rows }}</td>
      <td>{{ n_err }}</td>
      <td>{{ n_warn }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{# 4b. Check status grid (tables x checks) #}
{% set _cs = namespace(any=false, checks=[]) %}
{% for t in p.tables %}
  {% if t.by_check %}{% set _cs.any = true %}{% for name in t.by_check.keys() %}{% if name not in _cs.checks %}{% set _ = _cs.checks.append(name) %}{% endif %}{% endfor %}{% endif %}
{% endfor %}
{% if _cs.any %}
<h2>Check status</h2>
<table>
  <thead>
    <tr><th>Table</th>{% for name in _cs.checks|sort %}<th>{{ name }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
  {% for t in p.tables %}
    <tr>
      <td><strong>{{ t.table }}</strong></td>
      {% for name in _cs.checks|sort %}
        {% set s = t.by_check.get(name) %}
        {% if s is none %}
          <td></td>
        {% elif s.status == 'SKIPPED' %}
          <td style="color: var(--c-muted);">--</td>
        {% elif s.status == 'NA' %}
          <td style="color: var(--c-muted);">n/a</td>
        {% else %}
          {% set cls = 'fail' if s.status == 'ERROR' else ('warn' if s.status == 'WARNING' else 'pass') %}
          <td class="{{ cls }}" style="background: {{ 'var(--c-red)' if cls == 'fail' else ('var(--c-yellow)' if cls == 'warn' else 'var(--c-green)') }};">
            <strong>{{ s.status }}</strong>
            {% if s.scope == 'table' %}
              ({{ s.violation_count }})
            {% else %}
              <br><span style="font-size: 11px;">{{ s.pass_rows }}/{{ s.warning_rows }}/{{ s.error_rows }}</span>
            {% endif %}
          </td>
        {% endif %}
      {% endfor %}
    </tr>
  {% endfor %}
  </tbody>
</table>
<p style="font-size: 12px; color: var(--c-muted);">Cells show <code>pass / warn / err</code> row counts (row-scope checks) or <code>(count)</code> (table-scope checks).</p>
{% endif %}

{# 4c. Metrics panels per table #}
{% set _ms = namespace(any=false) %}
{% for t in p.tables %}{% if t.metrics %}{% set _ms.any = true %}{% endif %}{% endfor %}
{% if _ms.any %}
<h2>Metrics</h2>
{% for t in p.tables %}
  {% if t.metrics %}
  <details>
    <summary>{{ t.table }}</summary>
    <div class="body">
      {% set _tbl_metrics = [] %}
      {% set _field_metrics = [] %}
      {% for mname, mres in t.metrics.items() %}
        {% if mres.scope == 'table' %}{% set _ = _tbl_metrics.append((mname, mres)) %}{% else %}{% set _ = _field_metrics.append((mname, mres)) %}{% endif %}
      {% endfor %}
      {% if _tbl_metrics %}
      <p>{% for mname, mres in _tbl_metrics|sort %}<strong>{{ mname }}:</strong> {{ mres['values']['__table__'] }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
      {% endif %}
      {% if _field_metrics %}
        {% set _fnames = namespace(items=[]) %}
        {% for _mname, _mres in _field_metrics %}{% for _fn in _mres['values'].keys() %}{% if _fn != '__table__' and _fn not in _fnames.items %}{% set _ = _fnames.items.append(_fn) %}{% endif %}{% endfor %}{% endfor %}
      <table>
        <thead>
          <tr><th>Field</th>{% for mname, _ in _field_metrics|sort %}<th>{{ mname }}</th>{% endfor %}</tr>
        </thead>
        <tbody>
          {% for fname in _fnames.items|sort %}
          <tr>
            <td>{{ fname }}</td>
            {% for mname, mres in _field_metrics|sort %}
              {% set v = mres['values'].get(fname, '') %}
              <td>{% if v is number %}{{ "%.2f"|format(v) }}{% else %}{{ v }}{% endif %}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
  </details>
  {% endif %}
{% endfor %}
{% endif %}

{# 5. Top issues (across all tables) #}
{% set _ns = namespace(issues=[]) %}
{% for t in p.tables %}
  {% for v in t.violations %}
    {% set _ = _ns.issues.append({'table': t.table, 'v': v, 'count': v.row_count}) %}
  {% endfor %}
{% endfor %}

<h2>Top issues</h2>
{% if _ns.issues %}
  {% for i in _ns.issues|sort(attribute='count', reverse=true) %}
    {% if loop.index <= 10 %}
    <details class="issue">
      <summary>
        <span class="count">{{ i.v.row_count }}x</span>
        <span class="kind">{{ i.v.check_label or i.v.kind }}</span>
        {% if i.v.field %}on <code>{{ i.table }}.{{ i.v.field }}</code>{% else %}on <code>{{ i.table }}</code>{% endif %}
        <span class="pill {{ i.v.dimension }}">{{ i.v.dimension }}</span>
      </summary>
      <div class="body">
        <div class="hint">{{ i.v.hint }}</div>
        {% if i.v.top_values %}
        <table class="top-values">
          <thead><tr><th>Value</th><th>Rows</th></tr></thead>
          <tbody>
            {% for tv in i.v.top_values %}
              <tr><td><code>{{ tv.value }}</code></td><td>{{ tv.count }}</td></tr>
            {% endfor %}
            {% if i.v.remaining_rows %}
              <tr class="remainder"><td>+ {{ i.v.remaining_distinct }} other value(s)</td><td>{{ i.v.remaining_rows }}</td></tr>
            {% endif %}
          </tbody>
        </table>
        {% endif %}
      </div>
    </details>
    {% endif %}
  {% endfor %}
{% else %}
  <p style="color: var(--c-muted);">No issues detected.</p>
{% endif %}

{# 6. Table issues -- schema gaps + operational failures (no source row) #}
{% if p.run_issues %}
<h2>Table issues</h2>
<table>
  <thead>
    <tr><th>Severity</th><th>Table</th><th>Check</th><th>Field</th><th>Expected</th><th>Why</th></tr>
  </thead>
  <tbody>
  {% for issue in p.run_issues %}
    <tr class="{{ 'fail' if issue.severity == 'error' else ('warn' if issue.severity == 'warning' else 'pass') }}">
      <td><strong>{{ issue.severity|upper }}</strong></td>
      <td><code>{{ issue.table }}</code></td>
      <td>{% if issue.dimension %}<span class="pill {{ issue.dimension }}">{{ issue.dimension }}</span> {% endif %}{{ issue.check_label or issue.kind }}</td>
      <td>{% if issue.field %}<code>{{ issue.field }}</code>{% else %}-{% endif %}</td>
      <td>{{ issue.expected }}</td>
      <td style="color: var(--c-muted);">{{ issue.hint }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{# 7. Per-table data profile (collapsible) #}
<h2>Data profile</h2>
{% for t in p.tables %}
  {% if t.profile %}
  <details>
    <summary>{{ t.table }} ({{ t.profile.fields|length }} fields)</summary>
    <div class="body">
      <table>
        <thead>
          <tr>
            <th>Field</th><th>Type</th><th>Type Format</th>
            <th>Primary Key</th><th>Foreign Key</th>
            <th>Total</th><th>Null #</th><th>Null %</th><th>Distinct</th>
          </tr>
        </thead>
        <tbody>
          {% for f in t.profile.fields %}
          <tr>
            <td>{{ f.name }}</td>
            <td><code>{{ f.type }}</code></td>
            <td>{{ f.type_format }}</td>
            <td>{% if f.is_primary_key %}Y{% endif %}</td>
            <td>{% if f.is_foreign_key %}Y{% endif %}</td>
            <td>{{ f.total }}</td>
            <td>{% if f.null_count is none %}--{% else %}{{ f.null_count }}{% endif %}</td>
            <td>{% if f.null_pct is none %}--{% else %}{{ "%.1f"|format(f.null_pct) }}%{% endif %}</td>
            <td>{% if f.distinct_count is none %}--{% else %}{{ f.distinct_count }}{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {% endif %}
{% endfor %}

{# Checks section: enabled checks + descriptions + violation kinds #}
<h2>Checks</h2>
<table>
  <thead><tr><th>Check</th><th>Description</th><th>Violation kind</th></tr></thead>
  <tbody>
  {% for c in p.run.checks.active %}
    <tr>
      <td><strong>{{ c.name }}</strong></td>
      <td>{{ c.description }}</td>
      <td><code>{{ c.violation_kind }}</code></td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{# 8. Per-table rejected rows (collapsible, full source-row context) #}
{% set has_rejected = namespace(any=false) %}
{% for t in p.tables %}{% if t.rejected_rows %}{% set has_rejected.any = true %}{% endif %}{% endfor %}
{% if has_rejected.any %}
<h2>Rejected rows</h2>
{% for t in p.tables %}
  {% if t.rejected_rows %}
  <details>
    <summary>{{ t.table }} ({{ t.rejected_rows|length }} row{{ '' if t.rejected_rows|length == 1 else 's' }}{% if t.rejected_rows_truncated %} + {{ t.rejected_rows_truncated }} more truncated{% endif %})</summary>
    <div class="body">
      {% for r in t.rejected_rows %}
      <div class="rejected-row">
        <div class="head">
          <strong>{{ r.source_file }}</strong> row <strong>{{ r.source_row }}</strong>
          <span class="pill {{ 'uniqueness' if r.worst_severity == 'error' else 'validity' }}">{{ r.worst_severity }}</span>
        </div>
        {% if r.pk_values %}
        <div class="pk">
          PK:
          {% for k, v in r.pk_values.items() %}<code>{{ k }}={{ v }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        </div>
        {% endif %}
        <table class="violations">
          <thead>
            <tr><th>Column</th><th>Value</th><th>Check</th><th>Expected</th><th>Why</th></tr>
          </thead>
          <tbody>
            {% for v in r.violations %}
            <tr>
              <td>{% if v.field %}<code>{{ v.field }}</code>{% else %}-{% endif %}</td>
              <td>{% if v.offending_value is none %}<em>(null)</em>{% else %}<code>{{ v.offending_value }}</code>{% endif %}</td>
              <td><span class="pill {{ v.dimension }}">{{ v.dimension }}</span> {{ v.check_label or v.kind }}</td>
              <td>{{ v.expected }}</td>
              <td style="font-family: inherit; color: var(--c-muted);">{{ v.hint }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endfor %}
    </div>
  </details>
  {% endif %}
{% endfor %}
{% endif %}

{# 9. Run metadata footer #}
<footer>
  <dl>
    <dt>Epic</dt><dd>{{ p.run.epic }}</dd>
    <dt>Generated at</dt><dd>{{ p.run.generated_at }}</dd>
    <dt>Tool version</dt><dd>{{ p.run.tool_version }}</dd>
    <dt>Target</dt><dd>{% if p.run.target %}{{ p.run.target.name }} - {{ p.run.target.description }}{% else %}(none){% endif %}</dd>
    <dt>Types YAML</dt><dd><code>{{ p.run.types_yaml_path }}</code></dd>
    <dt>Checks enabled</dt><dd>{{ p.run.checks.enabled|join(', ') }}</dd>
    <dt>Checks disabled</dt><dd>{% if p.run.checks.disabled %}{{ p.run.checks.disabled|join(', ') }}{% else %}(none){% endif %}</dd>
    <dt>Contracts</dt><dd>{% for tbl, ver in p.run.contracts.items() %}{{ tbl }}={{ ver }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    <dt>CLI args</dt><dd><code>{{ p.run.cli_args|join(' ') }}</code></dd>
  </dl>
</footer>

</div>
</body>
</html>
